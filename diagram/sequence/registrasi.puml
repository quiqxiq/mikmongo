@startuml
!theme mars
autonumber
skinparam sequenceMessageAlign center

actor "Tamu" as Tamu
boundary "Halaman Registrasi" as UI
control "Sistem" as System
database "Database" as DB
participant "WA Gateway" as WA
actor "Admin" as Admin

group Proses Registrasi
    Tamu -> UI : Akses halaman & isi form
    activate UI
    UI -> UI : Validasi format input
    UI -> System : Submit data (POST /api/register)
    deactivate UI
    activate System

    System -> System : Validasi data & keunikan
    alt Data tidak valid / duplikat
        System --> UI : Return error
        deactivate System
        activate UI
        UI --> Tamu : Tampilkan error, minta isi ulang
        deactivate UI
    else Data valid
        System -> DB : INSERT customers (status='pending')
        activate DB
        DB --> System : Return ID
        deactivate DB

        System -> WA : Kirim notif ke Admin
        activate WA
        WA --> System : Terkirim
        deactivate WA

        System --> UI : Return sukses
        deactivate System
        activate UI
        UI --> Tamu : Tampilkan "Menunggu review"
        deactivate UI
    end
end

group Review Admin
    WA -> Admin : Notif WA: Registrasi baru
    
    Admin -> UI : Login & buka dashboard
    activate UI
    UI -> System : GET /api/customers/pending
    deactivate UI
    activate System
    System -> DB : Query data pending
    activate DB
    DB --> System : Return list
    deactivate DB
    System --> UI : Return data
    deactivate System
    activate UI
    UI --> Admin : Tampilkan data review
    deactivate UI

    alt Admin Setujui
        Admin -> UI : Klik Setujui + input jadwal
        activate UI
        UI -> System : PUT /approve {schedule}
        deactivate UI
        activate System
        System -> DB : UPDATE status='approved'
        activate DB
        DB --> System : OK
        deactivate DB
        System -> WA : Kirim WA persetujuan
        activate WA
        WA --> System : Terkirim
        deactivate WA
        System -> DB : INSERT audit log
        activate DB
        DB --> System : OK
        deactivate DB
        System --> UI : Return sukses
        deactivate System
        activate UI
        UI --> Admin : Tampilkan "Disetujui"
        deactivate UI
        WA --> Tamu : Terima WA jadwal
    else Admin Tolak
        Admin -> UI : Klik Tolak + input alasan
        activate UI
        UI -> System : PUT /reject {reason}
        deactivate UI
        activate System
        System -> DB : UPDATE status='rejected'
        activate DB
        DB --> System : OK
        deactivate DB
        System -> WA : Kirim WA penolakan
        activate WA
        WA --> System : Terkirim
        deactivate WA
        System -> DB : INSERT audit log
        activate DB
        DB --> System : OK
        deactivate DB
        System --> UI : Return sukses
        deactivate System
        activate UI
        UI --> Admin : Tampilkan "Ditolak"
        deactivate UI
        WA --> Tamu : Terima WA penolakan
    end
end
@enduml