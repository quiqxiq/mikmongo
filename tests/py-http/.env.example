# MikMongo API Python HTTP test suite — environment template
# Copy to .env and fill in real values. .env is gitignored.

# ---- Server ----
MIKMONGO_BASE_URL=http://localhost:8080

# ---- Admin login credentials (used by test_01_auth.py) ----
MIKMONGO_EMAIL=superadmin@mikmongo.local
MIKMONGO_PASSWORD=changeme

# ---- Optional: pre-seeded JWT (skips login) ----
# MIKMONGO_TOKEN=eyJhbGciOi...

# ---- Seeded UUIDs (mirror tests/http/environment.json) ----
MIKMONGO_ROUTER_ID=9eab7675-3abd-41df-97fc-1c8137367f5a
MIKMONGO_CUSTOMER_ID=cc7cead3-17e4-4bce-b635-a16ffb4e053e
MIKMONGO_USER_ID=5763b510-6053-41e2-a953-17496c57b4f1
MIKMONGO_SUBSCRIPTION_ID=65e6a6aa-c5b8-4eac-bc39-e5bae7ae2aeb
MIKMONGO_INVOICE_ID=e8f1a2b3-c4d5-4e6f-8a7b-12345678abcd
MIKMONGO_PAYMENT_ID=a1f4b4b7-28ca-4bfe-a102-100076ba26df
MIKMONGO_PROFILE_ID=8f42e08a-98da-4518-902d-f68281853023
MIKMONGO_SETTING_ID=

# ---- Test mode ----
# Set to 1 to enable mutating tests (POST/PATCH/DELETE/lifecycle).
# Default off so smoke runs are read-only and safe.
MIKMONGO_DESTRUCTIVE=0

# Set to 1 for verbose request/response logging
MIKMONGO_VERBOSE=0
